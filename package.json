{
  "name": "diana-mile",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:www": "npm run dev -w apps/www",
    "dev:linktree": "npm run dev -w apps/linktree",
    "dev:shop": "npm run dev -w apps/shop",
    "dev:admin": "npm run dev -w apps/admin",
    "dev:app": "npm run dev -w apps/app",
    "build": "npm run build -ws --if-present",
    "lint": "npm run lint -ws --if-present",
    "landing:gen": "node scripts/generate-landing.mjs",
    "collection:gen": "node scripts/generate-collection.mjs",
    "wa:probar": "tsx scripts/probar-agente-wa.mts",
    "wa:pedido": "tsx scripts/probar-pedido-wa.mts",
    "wa:diario": "tsx scripts/probar-diario-wa.mts",
    "wa:guardia": "tsx scripts/probar-guardia-catalogo.mts",
    "wa:upsell": "tsx scripts/probar-upsell.mts",
    "wa:edicion": "tsx scripts/probar-edicion-orden.mts",
    "shopify:webhooks": "node scripts/webhooks-shopify.mjs",
    "wa:guardas": "tsx scripts/probar-guardas.mts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "xlsx": "^0.18.5"
  }
}
